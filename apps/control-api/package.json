{
  "name": "@screen-share/control-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun ../../scripts/build-api.ts",
    "typecheck": "bun --bun ../../node_modules/typescript/bin/tsc -p tsconfig.check.json",
    "migrate": "bun src/index.ts migrate",
    "smoke": "bun src/index.ts smoke",
    "test:integration": "bun test --isolate --timeout 15000 ./test/database.integration.test.ts",
    "db:generate": "bun --bun node_modules/drizzle-kit/bin.cjs generate",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@screen-share/contracts": "workspace:*",
    "hono": "4.13.14",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "livekit-server-sdk": "2.19.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaovito/screen-share.git"
  }
}
