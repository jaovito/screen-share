{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "noEmit": true,
    "types": ["bun", "node"],
    "paths": {
      "@modules/*": ["./src/modules/*"],
      "@runtime/*": ["./src/runtime/*"]
    }
  },
  "include": ["src"]
}
