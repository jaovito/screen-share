{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "types": ["bun", "node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "scripts/**/*.ts",
    "tooling/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "apps/*/vite.config.ts",
    "packages/*/test/**/*.ts"
  ]
}
